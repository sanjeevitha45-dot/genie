# ==============================================================================
# ARTISAN COMMERCE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Gemini AI Configuration
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Backend Server Port
PORT=5000

# Supabase Configuration
# Retrieve these from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-or-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Client-side Vite Supabase Variables (Public Anon Key)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-public-key"
